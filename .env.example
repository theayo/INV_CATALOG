# Local Docker infrastructure. Development credentials only.
POSTGRES_DB=invix
POSTGRES_USER=invix
POSTGRES_PASSWORD=invix_dev_password
POSTGRES_PORT=5432
MINIO_ROOT_USER=invix_local
MINIO_ROOT_PASSWORD=invix_dev_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Backend started directly on the host.
APP_ENV=development
DATABASE_URL=postgresql://invix:invix_dev_password@localhost:5432/invix
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=invix_local
MINIO_SECRET_KEY=invix_dev_minio_password
MINIO_BUCKET=product-photos
MINIO_SECURE=false

# Frontend started directly on the host.
API_BASE_URL=http://localhost:8000
WEB_APP_URL=http://localhost:3000
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Required to receive Telegram updates and enable the demo admin role.
BOT_TOKEN=
DEMO_ADMIN_CODE=
TELEGRAM_WEBHOOK_SECRET=
